# Supabase — copiá este archivo a .env.local y completá los valores
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Solo servidor — service role key. NO exponer al cliente.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para el endpoint de ingesta de n8n (Fase 4).
# Generá uno con: openssl rand -hex 32
N8N_INGEST_SECRET=

# --- Operon IA (Hermes) ---
# Sólo servidor: la UI nunca habla directo con Hermes, siempre pasa por
# /api/assistant/chat, que ya verificó la sesión de Supabase.
# Sin estas dos variables el asistente se muestra como no configurado.
HERMES_API_URL=
HERMES_API_KEY=

# --- Zernio (WhatsApp + Instagram) ---
# Clave de la API: panel de Zernio > API keys. Formato: sk_ + 64 hexadecimales.
# Da acceso de escritura a WhatsApp e Instagram: nunca con prefijo NEXT_PUBLIC_.
ZERNIO_API_KEY=

# Secreto del webhook. Lo elegís vos y lo registrás en Zernio al dar de alta el
# endpoint; con él se firma cada evento (HMAC-SHA256 sobre el cuerpo crudo).
# Generá uno con: openssl rand -hex 32
ZERNIO_WEBHOOK_SECRET=

# Opcional. El "profile" de Zernio agrupa las cuentas conectadas.
# Vacío = se listan todas las cuentas de la clave.
ZERNIO_PROFILE_ID=

# Opcional. Sólo para apuntar a otra base (pruebas).
# Por defecto: https://zernio.com/api/v1
ZERNIO_API_URL=
