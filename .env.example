# Supabase — copiá este archivo a .env.local y completá los valores
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Solo servidor — service role key. NO exponer al cliente.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para el endpoint de ingesta de n8n (Fase 4).
# Generá uno con: openssl rand -hex 32
N8N_INGEST_SECRET=
